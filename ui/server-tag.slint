import { PictureStore } from "controls.slint";

// The card a server tag opens, as Discord's: the server it's from.
export global TagCard {
    in-out property <bool> open;
    in-out property <string> guild;
    in-out property <string> text;
    in-out property <string> badge;
    in-out property <string> name;
    in-out property <string> icon;
    in-out property <string> banner;
    in-out property <bool> joined;
    /// The server's Discord id, as the tag gave it.
    in-out property <string> raw;
    in-out property <string> online;
    in-out property <string> members;
    in-out property <string> founded;
    in-out property <string> description;
    in-out property <bool> loading;
    in-out property <bool> failed;
    in-out property <length> x;
    in-out property <length> y;
    /// A tag was clicked: its server's id, letters, badge, and where.
    callback show(string, string, string, length, length);
    callback go-to-server(string);
}

// Discord's server tag by a name: its badge and up to four letters on a grey pill.
export component ServerTagPill inherits Rectangle {
    in property <string> text;
    in property <string> badge;
    /// The server it's from, by id, which a click shows.
    in property <string> guild;
    property <image> picture: root.badge != "" ? PictureStore.picture(root.badge, PictureStore.revision) : @image-url("");
    function request() {
        if root.badge != "" && root.picture.width == 0 {
            PictureStore.request(root.badge);
        }
    }
    init => { root.request(); }
    changed badge => { root.request(); }
    changed picture => { root.request(); }
    height: 18px;
    width: tag-row.preferred-width;
    horizontal-stretch: 0;
    border-radius: 4px;
    background: #97979f29;
    accessible-role: AccessibleRole.text;
    accessible-label: "Server tag " + root.text;
    tag-row := HorizontalLayout {
        padding-left: 4px; padding-right: 5px; spacing: 3px; alignment: start;
        if root.badge != "": VerticalLayout {
            alignment: center;
            Image { source: root.picture; width: 12px; height: 12px; image-fit: contain; }
        }
        Text { text: root.text; color: #dbdee1; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { TagCard.show(root.guild, root.text, root.badge, self.absolute-position.x, self.absolute-position.y + root.height + 4px); }
    }
}

// A picture asked for as it shows.
component CardPicture inherits Image {
    in property <string> url;
    source: root.url != "" ? PictureStore.picture(root.url, PictureStore.revision) : @image-url("");
    function request() {
        if root.url != "" && self.source.width == 0 {
            PictureStore.request(root.url);
        }
    }
    init => { root.request(); }
    changed url => { root.request(); }
}

// The card over everything, closed by a click outside it, laid out as
// Discord's: a banner, the server's icon over its lower edge, then its name
// and tag, how many are online and in it, and when it was made.
export component TagCardPopup inherits Rectangle {
    if TagCard.open: Rectangle {
        width: root.width; height: root.height;
        TouchArea { clicked => { TagCard.open = false; } }
        Rectangle {
            x: max(8px, min(TagCard.x, root.width - self.width - 8px));
            y: max(8px, min(TagCard.y, root.height - self.height - 8px));
            width: 380px; height: card-column.preferred-height;
            background: #111214; border-radius: 12px; border-width: 1px; border-color: #2e3035; clip: true;
            drop-shadow-blur: 16px; drop-shadow-color: #00000080;
            TouchArea { }
            card-column := VerticalLayout {
                Rectangle {
                    height: 150px; background: #3a3c42;
                    if TagCard.banner != "": CardPicture { url: TagCard.banner; width: parent.width; height: parent.height; image-fit: cover; }
                }
                VerticalLayout {
                    padding-left: 20px; padding-right: 20px; padding-top: 46px; padding-bottom: 18px; spacing: 6px;
                    HorizontalLayout {
                        alignment: start; spacing: 6px;
                        Text { text: TagCard.name != "" ? TagCard.name : "Server tag"; color: #f2f3f5; font-size: 18px; font-weight: 700; overflow: elide; vertical-alignment: center; }
                        VerticalLayout { alignment: center; ServerTagPill { text: TagCard.text; badge: TagCard.badge; guild: TagCard.raw; } }
                    }
                    if TagCard.online != "" || TagCard.members != "": HorizontalLayout {
                        alignment: start; spacing: 10px;
                        if TagCard.online != "": HorizontalLayout {
                            spacing: 5px;
                            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #23a55a; } }
                            Text { text: TagCard.online + " Online"; color: #b5bac1; font-size: 15px; }
                        }
                        if TagCard.members != "": HorizontalLayout {
                            spacing: 5px;
                            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #80848e; } }
                            Text { text: TagCard.members + " Members"; color: #b5bac1; font-size: 15px; }
                        }
                    }
                    if TagCard.founded != "": Text { text: TagCard.founded; color: #b5bac1; font-size: 15px; }
                    if TagCard.description != "": Text { text: TagCard.description; color: #dbdee1; font-size: 14px; wrap: word-wrap; }
                    if TagCard.loading: Text { text: "Loading..."; color: #949ba4; font-size: 13px; }
                    if TagCard.failed && !TagCard.joined: Text { text: "Discord didn't share more about this server."; color: #949ba4; font-size: 13px; wrap: word-wrap; }
                    if TagCard.joined: VerticalLayout {
                        padding-top: 8px;
                        Rectangle {
                            height: 38px; border-radius: 8px;
                            background: go-touch.has-hover ? #1a6334 : #248046;
                            accessible-role: button; accessible-label: "Go to Server";
                            Text { text: "Go to Server"; color: #ffffff; font-size: 14px; font-weight: 600; }
                            go-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { TagCard.go-to-server(TagCard.guild); } }
                        }
                    }
                }
            }
            // The server's icon, over the banner's lower edge.
            Rectangle {
                x: 16px; y: 104px; width: 88px; height: 88px; border-radius: 26px; background: #111214;
                Rectangle {
                    x: 4px; y: 4px; width: 80px; height: 80px; border-radius: 22px; background: #2b2d31; clip: true;
                    if TagCard.icon != "": CardPicture { url: TagCard.icon; width: 80px; height: 80px; image-fit: cover; }
                }
            }
        }
    }
}
